{
  "name": "cad-leadership-dashboard",
  "version": "1.0.0",
  "description": "Mission-critical CAD delivery system leadership dashboard",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "bash tools/testing/comprehensive-test.sh",
    "health": "curl http://localhost:3000/api/health",
    "lint": "eslint .",
    "setup": "npm install && echo 'Setup complete! Run: npm start'",
    "health-check": "node scripts/health-check.js",
    "build": "pkg app.js --targets node18-linux-x64,node18-win-x64,node18-macos-x64 --out-path ./dist/",
    "build-win": "pkg app.js --targets node18-win-x64 --out-path ./dist/",
    "build-linux": "pkg app.js --targets node18-linux-x64 --out-path ./dist/"
  },
  "bin": "app.js",
  "pkg": {
    "assets": [
      "public/**/*",
      "logs/**/*",
      "uploads/**/*"
    ],
    "scripts": [
      "app.js"
    ]
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "fs-extra": "^11.1.1",
    "moment": "^2.29.4",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.8.1",
    "winston": "^3.10.0",
    "joi": "^17.9.2",
    "uuid": "^9.0.0",
    "compression": "^1.7.4",
    "node-cron": "^3.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.1",
    "eslint": "^8.44.0"
  },
  "keywords": ["cad", "drone", "dashboard", "leadership", "real-time", "mission-critical"],
  "author": "evilscriptbull",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
